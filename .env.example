# Neon Postgres connection string (run db/schema.sql on it once)
DATABASE_URL=

# Claude — VELO_MODEL is the model id Velo talks with
ANTHROPIC_API_KEY=
VELO_MODEL=

# Optional: natural voice on calls (falls back to the device voice without it)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=

# Velo Pro — subscription (Stripe)
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=

# Velo Pro — Velo's own phone number (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Velo Pro — Facebook Page posting (Meta app)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_TOKEN_KEY=   # 32 random bytes, base64: openssl rand -base64 32
APP_ORIGIN=           # e.g. https://velo-wheat-seven.vercel.app (must match the Meta redirect URI)

# Optional: your Amazon Associates tag, added to cart links (earns referral fees)
AMAZON_ASSOCIATE_TAG=

# Optional chat models people can pick in Settings → Velo's brain (OpenAI-compatible APIs).
# Each shows up only when its key and model are set.
QWEN_API_KEY=          # Alibaba Cloud Model Studio (DashScope) key
QWEN_MODEL=
QWEN_BASE_URL=         # default: international endpoint
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=     # default: DeepSeek's API
